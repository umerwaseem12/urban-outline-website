# Frontend (Vite) environment variables.
# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_.

# Base URL of the Express backend, without a trailing slash.
# Local development: http://localhost:5000
# Production:        https://urban-outline-backend.vercel.app
VITE_API_URL=http://localhost:5000

# Google OAuth client ID used by the account page.
VITE_GOOGLE_CLIENT_ID=
