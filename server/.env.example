# Backend (Express) environment variables.
# Copy to server/.env. The server refuses to start without MONGODB_URI.

# MongoDB connection string (Atlas or local).
MONGODB_URI=

# Port the API listens on.
PORT=5000

# Origins allowed to call the API with credentials (comma-separated).
# Local:      http://localhost:5173,http://127.0.0.1:5173
# Production: http://localhost:5173,https://urban-outline.vercel.app
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Secure cookies and cross-site cookies are enabled when this is "production".
NODE_ENV=development

# Google OAuth client ID (same value as VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Gemini API key used by the shopping assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Gmail account used for order and contact emails (use an app password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
